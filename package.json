{
  "name": "google-play-books-web-extended",
  "description": "Extension to add features to Google Play Books, such as page animations, bubble zoom, book theme etc.",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "export CHROME_PATH=$(which thorium-browser) && wxt",
    "dev:firefox": "export $(grep -v '^#' .env | xargs) && wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
